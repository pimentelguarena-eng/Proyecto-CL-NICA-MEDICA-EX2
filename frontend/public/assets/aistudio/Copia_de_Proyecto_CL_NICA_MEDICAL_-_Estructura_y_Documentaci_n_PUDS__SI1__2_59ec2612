   25. pagos_citas: (id [PK], cita_id [FK -> citas_medicas.id, UNIQUE], monto, metodo_pago, transaccion_pasarela_id [UNIQUE], estado_pago, comprobante_oficial_nro, fecha_pago)
   26. historial_clinico: (id [PK], cita_id [FK -> citas_medicas.id, UNIQUE], paciente_id [FK -> pacientes.id], medico_id [FK -> medicos.id], presion_arterial, temperatura_c, frecuencia_cardiaca, peso_kg, talla_cm, sintomas, anamnesis, diagnostico_principal, tratamiento_receta, observaciones, fecha_atencion [INMUTABLE])
   27. bitacora: (id [PK], usuario_id [FK -> usuarios.id], rol_ejecutor, modulo_afectado, tipo_evento, descripcion_accion, ip_direccion, fecha_hora [INMUTABLE])
