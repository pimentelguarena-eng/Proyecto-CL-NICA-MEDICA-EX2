-- CONSULTA BÁSICA 1: Búsqueda instantánea y autocompletado de paciente por CI (CU06, CU07, CU14)
SELECT p.id, p.ci, p.nombres, p.apellidos, p.telefono, p.correo,
       a.grupo_sanguineo, a.alergias, a.patologias_cronicas
FROM pacientes p
LEFT JOIN antecedentes_medicos a ON a.paciente_id = p.id
WHERE p.ci = '8845123' AND p.estado = 'activo';


-- CONSULTA BÁSICA 2: Listar las 22 Especialidades y 9 Servicios con su política ambulatoria (CU10)
SELECT codigo, nombre, tipo_catalogo, servicios_especificos, costo_consulta, politica_ambulatoria
FROM especialidades
WHERE estado = 'activo'
ORDER BY tipo_catalogo, nombre;




-- CONSULTA INTERMEDIA 3: Agenda Médica Diaria ordenada por bloques de 15 minutos (CU19)
SELECT c.codigo_cita, c.hora_inicio_bloque, c.hora_fin_bloque,
       p.ci, p.nombres || ' ' || p.apellidos AS paciente,
       EXTRACT(YEAR FROM AGE(c.fecha_cita, p.fecha_nacimiento)) AS edad,
       c.motivo_consulta, c.estado_cita, con.codigo AS consultorio
FROM citas_medicas c
INNER JOIN pacientes p ON p.id = c.paciente_id
INNER JOIN consultorios con ON con.id = c.consultorio_id
WHERE c.medico_id = 1 AND c.fecha_cita = CURRENT_DATE
ORDER BY c.hora_inicio_bloque ASC;


-- CONSULTA AVANZADA 4: Reporte Estadístico Gerencial por Especialidad e Ingresos (CU23)
SELECT e.nombre AS especialidad,
       COUNT(c.id) AS total_citas,
       SUM(CASE WHEN c.estado_cita = 'Atendida' THEN 1 ELSE 0 END) AS atendidas,
       SUM(CASE WHEN c.estado_cita = 'Cancelada' THEN 1 ELSE 0 END) AS canceladas,
       SUM(CASE WHEN c.estado_cita = 'Inasistencia' THEN 1 ELSE 0 END) AS inasistencias,
       ROUND(SUM(CASE WHEN c.estado_cita = 'Atendida' THEN 1 ELSE 0 END)::NUMERIC / NULLIF(COUNT(c.id), 0) * 100, 2) AS tasa_efectividad_pct,
       COALESCE(SUM(CASE WHEN pg.estado_pago = 'Aprobado' THEN pg.monto ELSE 0 END), 0) AS ingresos_confirmados_bs
FROM especialidades e
LEFT JOIN citas_medicas c ON c.especialidad_id = e.id
LEFT JOIN pagos_citas pg ON pg.cita_id = c.id
GROUP BY e.id, e.nombre
ORDER BY ingresos_confirmados_bs DESC;
